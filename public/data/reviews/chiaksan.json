-01","sources":["https://www.knps.or.kr/front/portal/visit/visitCourseMain.do?zoneId=L03&courseId=C0303","https://ggobuk11.tistory.com/12"],"verify":{"level":"single","confirmed":1,"checked_by":2,"found_by":1}},{"scope":"mountain","route":null,"topic":"주차·교통","text":"구룡사 주차장은 유료로 운영되며 12시간 기준 소형차 5,000원의 주차 요금이 부과된다.","sentiment":"neutral","as_of":"2024-10","sources":["http://www.chiaknews.co.kr/news/articleView.html?idxno=27027","https://blog.naver.com/iloveknp/223598461638"],"verify":{"level":"single","confirmed":1,"checked_by":2,"found_by":1}}]}