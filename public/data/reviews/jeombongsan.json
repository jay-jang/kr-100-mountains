p.go.kr/pot/frtrl/et/selectEcoTravelDtl1.do?hmpgId=FRTRL"],"verify":{"level":"single","confirmed":1,"checked_by":1,"found_by":1}},{"scope":"route","route":"점봉산분소-곰배골-곰배령","topic":"주차·교통","text":"공단 안내의 출발지는 인제군 인제읍 곰배골길 203 점봉산분소이며, 주차시설은 점봉산분소 주차장으로 안내돼 있다.","sentiment":"neutral","as_of":null,"sources":["https://reservation.knps.or.kr/contents/T/serviceGuide.do?parkId=B03&prdDvcd=T"],"verify":{"level":"single","confirmed":1,"checked_by":1,"found_by":1}},{"scope":"route","route":"곰배골 코스","topic":"난이도","text":"2023년 4월 30일 후기에서는 곰배령까지 900m 남은 제2쉼터 이후 급한 오르막이 시작됐고, 정상까지 약 30분 동안 여러 차례 쉬어야 했다고 기록했다.","sentiment":"neutral","as_of":"2023-04","sources":["https://tks042.tistory.com/12362794"],"verify":{"level":"single","confirmed":1,"checked_by":1,"found_by":1}},{"scope":"route","route":"곰배령 산림생태탐방 코스","topic":"편의시설","text":"숲나들e 공식 안내는 출발 후 약 4시간의 탐방 동안 화장실이 없으므로 출발 전에 이용하도록 안내한다.","sentiment":"neutral","as_of":null,"sources":["https://www.foresttrip.go.kr/pot/frtrl/et/selectEcoTravelDtl1.do?hmpgId=FRTRL"],"verify":{"level":"single","confirmed":1,"checked_by":1,"found_by":1}},{"scope":"route","route":"곰배령 산림생태탐방 코스","topic":"주차·교통","text":"숲나들e 안내상 현리시외버스터미널~진동2리 설피밭 버스는 하루 3회 운행한다. 해당 버스로는 입산 마감인 11시 이전 관리센터 도착이 불가능해 대중교통 당일 탐방이 어렵다고 설명한다.","sentiment":"neutral","as_of":null,"sources":["https://www.foresttrip.go.kr/pot/frtrl/et/selectEcoTravelDtl1.do?hmpgId=FRTRL"],"verify":{"level":"single","confirmed":1,"checked_by":1,"found_by":1}}]}